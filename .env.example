# Copy to .env and fill in. The .env file is git-ignored.

# Required for the conversational (Claude) layer. Without it, the assistant
# still runs in retrieval-only mode (product/category matching + templated replies).
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-opus-5
TOP_K_PRODUCTS=5
TOP_K_CATEGORIES=3
TOP_K_KNOWLEDGE=3
