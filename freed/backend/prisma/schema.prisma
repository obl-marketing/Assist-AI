// ============================================================================
// FREED — data model
// "Talk to someone who knows."
//
// A verified-expertise marketplace. The schema is deliberately CLAIM-CENTRIC:
// an expert is a bundle of individually verifiable credentials, each with its
// own lifecycle — not a single `is_verified` boolean. This is what lets the
// UI show "4 verified credentials" and a Trust Profile instead of a badge you
// can buy.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — the source of truth for domain states
// ---------------------------------------------------------------------------

/// The five founding supply verticals.
enum Vertical {
  EXAMS_ACADEMICS
  CAREER_PROFESSIONAL
  SPORTS_PERFORMANCE
  TEACHING_KNOWLEDGE
  WELLNESS_GUIDANCE
}

enum Role {
  USER
  EXPERT
  ADMIN
}

/// How a person is presented to seekers. The UI must NEVER blur these — a
/// licensed professional is not a coach.
enum ProfessionalClass {
  LICENSED_PROFESSIONAL // holds a valid statutory registration (e.g. RCI, INC)
  CERTIFIED_PROFESSIONAL // recognised certification, not a statutory licence
  VERIFIED_EXPERT // credentials + experience checked
  COACH
  MENTOR
  TEACHER
  ADVISOR
}

/// The kind of thing a credential asserts. Each maps to a verification path.
enum CredentialType {
  IDENTITY
  EDUCATION
  PROFESSIONAL_QUALIFICATION
  EMPLOYMENT
  CERTIFICATION
  ACHIEVEMENT
  PROFESSIONAL_REGISTRATION
  EXAM_QUALIFICATION
}

/// The lifecycle of a single verification claim.
enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  REQUIRES_REVERIFICATION
}

/// How a claim was (or will be) checked. OCR only EXTRACTS; it never verifies.
enum VerificationMethod {
  AUTOMATED_SOURCE // queried an authoritative register/API
  DOCUMENT_OCR // extraction only — must be paired with another check
  MANUAL_REVIEW // a human on the trust team confirmed it
  EXTERNAL_API
}

/// Known authoritative sources the verification engine can plug into.
/// GENERIC_DOCUMENT is the fallback (upload + manual review).
enum VerificationSourceKey {
  RCI_CRR // Rehabilitation Council of India — Central Rehabilitation Register
  INC_NRTS // Indian Nursing Council — Nurses Registration & Tracking System
  NTA_UGC_NET // National Testing Agency — UGC-NET / JRF certificate
  INSTITUTE_DEGREE // IIT/IIM/NIT/university degree verification
  EMPLOYER // employment verification
  SPORTS_FEDERATION // federation / official achievement record
  GENERIC_DOCUMENT
}

/// Real-time presence for instant consultations.
enum AvailabilityState {
  OFFLINE
  AVAILABLE
  BUSY
  IN_SESSION
  AWAY
}

/// The three pricing models FREED supports.
enum PricingModel {
  PER_MINUTE // instant consultation
  FIXED_SESSION // e.g. 30/45/60 min
  PRODUCT // resume review, mock interview, study plan…
}

enum ConsultationMode {
  CHAT
  AUDIO
  VIDEO
}

enum ServiceKind {
  INSTANT
  SCHEDULED
  PRODUCT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

// ---------------------------------------------------------------------------
// Catalog — verticals & their sub-categories (seeded, not user-generated)
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  vertical  Vertical
  key       String   @unique // e.g. "gate-cse", "product-management"
  name      String
  blurb     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  experts ExpertCategory[]

  @@index([vertical])
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  role         Role      @default(USER)
  // Progressive signup: only phone/email is required up front.
  phone        String?   @unique
  email        String?   @unique
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  name         String?
  avatarColor  String? // deterministic gradient seed, not a stock photo
  // "What are you here for?" — captured progressively, never blocking.
  intent       String?
  languages    String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  expertProfile ExpertProfile?
  bookings      Booking[]      @relation("SeekerBookings")
  payments      Payment[]
  reviews       Review[]       @relation("ReviewsByUser")
  reportsMade   Report[]       @relation("ReportsByUser")
  authSessions  AuthSession[]
  messages      Message[]
  conversations ConversationParticipant[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // hashed refresh token; short-lived access tokens are stateless (JWT)
  tokenHash String
  device    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Expert profile & its credential graph
// ---------------------------------------------------------------------------

model ExpertProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  headline          String? // "Product Manager | Ex-Google"
  bio               String?
  professionalClass ProfessionalClass @default(VERIFIED_EXPERT)
  yearsExperience   Int               @default(0)

  // Founding-cohort designation. NOT a paid badge — it marks an early,
  // hand-recruited high-quality expert.
  foundingExpert    Boolean           @default(false)
  proPlan           Boolean           @default(false) // FREED Pro (paid tools, never verification)

  // Onboarding is progressive and resumable.
  onboardingStep    Int               @default(0)
  onboardingTotal   Int               @default(11)
  submittedForReview Boolean          @default(false)
  approved          Boolean           @default(false)

  // Denormalised marketplace signals (kept fresh by services/jobs).
  ratingAvg         Float             @default(0)
  ratingCount       Int               @default(0)
  consultCount      Int               @default(0)

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  categories        ExpertCategory[]
  credentials       Credential[]
  registrations     ProfessionalRegistration[]
  achievements      Achievement[]
  employment        EmploymentHistory[]
  services          ExpertService[]
  availability      Availability?
  slots             AvailabilitySlot[]
  bookings          Booking[]         @relation("ExpertBookings")
  reviews           Review[]          @relation("ReviewsOfExpert")
  payouts           Payout[]
  reports           Report[]          @relation("ReportsOfExpert")
  verificationRequests VerificationRequest[]

  @@index([professionalClass])
}

model ExpertCategory {
  expertId   String
  expert     ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  primary    Boolean       @default(false)

  @@id([expertId, categoryId])
  @@index([categoryId])
}

/// A single verifiable claim. Verification lives in its own table so a claim
/// can be re-checked and expire without losing history.
model Credential {
  id            String                 @id @default(cuid())
  expertId      String
  expert        ExpertProfile          @relation(fields: [expertId], references: [id], onDelete: Cascade)
  type          CredentialType
  title         String // "B.Tech CSE, IIT Bombay" / "GATE CSE AIR 42"
  issuer        String? // institute / authority / employer
  identifier    String? // roll no, registration no, certificate no (encrypted at rest)
  year          Int?
  metadata      Json? // type-specific fields (subject, category, competition…)
  documents     Document[]
  verification  CredentialVerification?
  createdAt     DateTime               @default(now())

  @@index([expertId, type])
}

/// The verification state of one credential. One-to-one with Credential.
model CredentialVerification {
  id            String                @id @default(cuid())
  credentialId  String                @unique
  credential    Credential            @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  status        VerificationStatus    @default(PENDING)
  method        VerificationMethod?
  sourceKey     VerificationSourceKey?
  reviewerId    String? // admin user id, when MANUAL_REVIEW
  evidence      Json? // structured result from the provider
  notes         String?
  verifiedAt    DateTime?
  expiresAt     DateTime? // registrations/certs can expire → REQUIRES_REVERIFICATION
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status])
}

/// Statutory registrations (RCI/CRR, Nursing Council, etc.). Modelled
/// separately because they carry authority-specific fields and expiry.
model ProfessionalRegistration {
  id            String                @id @default(cuid())
  expertId      String
  expert        ExpertProfile         @relation(fields: [expertId], references: [id], onDelete: Cascade)
  authority     VerificationSourceKey
  registerName  String // "Central Rehabilitation Register"
  registrationNo String
  validFrom     DateTime?
  validTo       DateTime?
  status        VerificationStatus    @default(PENDING)
  createdAt     DateTime              @default(now())

  @@index([expertId])
}

model Achievement {
  id        String        @id @default(cuid())
  expertId  String
  expert    ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  title     String // "Represented India — 2018 Asian Games"
  level     String? // National / International / Asian Games / Olympic…
  sport     String?
  year      Int?
  status    VerificationStatus @default(PENDING)
  documents Document[]
  createdAt DateTime      @default(now())

  @@index([expertId])
}

model EmploymentHistory {
  id        String        @id @default(cuid())
  expertId  String
  expert    ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  company   String
  role      String
  startDate DateTime?
  endDate   DateTime? // null = current
  status    VerificationStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@index([expertId])
}

// ---------------------------------------------------------------------------
// Services, pricing & availability
// ---------------------------------------------------------------------------

model ExpertService {
  id             String            @id @default(cuid())
  expertId       String
  expert         ExpertProfile     @relation(fields: [expertId], references: [id], onDelete: Cascade)
  kind           ServiceKind
  title          String // "Ask a GATE Mentor", "Mock Interview", "PhD Application Review"
  description    String?
  modes          ConsultationMode[] @default([])
  pricingModel   PricingModel
  // Only the field(s) relevant to pricingModel are set.
  ratePerMinute  Int? // paise or rupees (integer); PER_MINUTE
  sessionPrice   Int? // FIXED_SESSION
  durationMinutes Int? // FIXED_SESSION
  productPrice   Int? // PRODUCT
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())

  bookings       Booking[]

  @@index([expertId, kind])
}

/// Real-time presence, one row per expert.
model Availability {
  expertId       String            @id
  expert         ExpertProfile     @relation(fields: [expertId], references: [id], onDelete: Cascade)
  state          AvailabilityState @default(OFFLINE)
  modes          ConsultationMode[] @default([])
  nextAvailableAt DateTime? // powers "Available in 12 min" / "Next at 4:30 PM"
  updatedAt      DateTime          @updatedAt

  @@index([state])
}

/// Bookable slots for SCHEDULED services.
model AvailabilitySlot {
  id        String        @id @default(cuid())
  expertId  String
  expert    ExpertProfile @relation(fields: [expertId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  booked    Boolean       @default(false)

  @@index([expertId, startsAt])
}

// ---------------------------------------------------------------------------
// Consultations, bookings & money
// ---------------------------------------------------------------------------

model Booking {
  id          String        @id @default(cuid())
  seekerId    String
  seeker      User          @relation("SeekerBookings", fields: [seekerId], references: [id])
  expertId    String
  expert      ExpertProfile @relation("ExpertBookings", fields: [expertId], references: [id])
  serviceId   String?
  service     ExpertService? @relation(fields: [serviceId], references: [id])
  mode        ConsultationMode?
  status      BookingStatus @default(PENDING)
  scheduledAt DateTime? // null for instant
  durationMinutes Int?
  // money is captured on the Payment; these are the agreed figures
  amount      Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  consultation Consultation?
  payment      Payment?
  review       Review?

  @@index([seekerId])
  @@index([expertId, status])
}

/// The live session itself (instant or scheduled). Tracks metered usage.
model Consultation {
  id          String            @id @default(cuid())
  bookingId   String            @unique
  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mode        ConsultationMode
  startedAt   DateTime?
  endedAt     DateTime?
  seconds     Int               @default(0)
  costMinor   Int               @default(0) // running/final cost in minor units
  recordingConsent Boolean      @default(false)
  createdAt   DateTime          @default(now())
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  gateway       String        @default("razorpay")
  gatewayRef    String?
  amount        Int // total charged to seeker
  platformFee   Int           @default(0)
  tax           Int           @default(0)
  status        PaymentStatus @default(CREATED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payout        Payout?
}

model Payout {
  id         String       @id @default(cuid())
  expertId   String
  expert     ExpertProfile @relation(fields: [expertId], references: [id])
  paymentId  String       @unique
  payment    Payment      @relation(fields: [paymentId], references: [id])
  amount     Int // expert take-home after fees/taxes
  status     PayoutStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([expertId, status])
}

// ---------------------------------------------------------------------------
// Trust: reviews, reports, disputes, verification workflow
// ---------------------------------------------------------------------------

model Review {
  id        String        @id @default(cuid())
  bookingId String        @unique
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("ReviewsByUser", fields: [userId], references: [id])
  expertId  String
  expert    ExpertProfile @relation("ReviewsOfExpert", fields: [expertId], references: [id])
  rating    Int // 1..5
  useful    String? // Yes / Somewhat / No
  again     String? // Yes / Maybe / No
  tags      String[]      @default([])
  text      String?
  createdAt DateTime      @default(now())

  @@index([expertId])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("ReportsByUser", fields: [reporterId], references: [id])
  expertId   String?
  expert     ExpertProfile? @relation("ReportsOfExpert", fields: [expertId], references: [id])
  reason     String
  detail     String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@index([status])
}

model Dispute {
  id        String        @id @default(cuid())
  bookingId String
  reason    String
  detail    String?
  status    DisputeStatus @default(OPEN)
  resolution String?
  createdAt DateTime      @default(now())

  @@index([status])
}

/// A batch verification workflow item (an expert submitting for review, or a
/// scheduled re-verification). Individual claim states live on
/// CredentialVerification; this tracks the overall queue.
model VerificationRequest {
  id        String             @id @default(cuid())
  expertId  String
  expert    ExpertProfile      @relation(fields: [expertId], references: [id], onDelete: Cascade)
  status    VerificationStatus @default(PENDING)
  requested String[]           @default([]) // which CredentialTypes to verify
  reviewerId String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
}

model Document {
  id           String      @id @default(cuid())
  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  achievementId String?
  achievement  Achievement? @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  // Object storage key (S3-compatible). Never a public URL.
  storageKey   String
  contentType  String?
  createdAt    DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Messaging (chats stay inside FREED; numbers never auto-shared)
// ---------------------------------------------------------------------------

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  attachmentKey  String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
