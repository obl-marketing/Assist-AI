# FREED backend — copy to .env and fill in
DATABASE_URL="postgresql://freed:freed@localhost:5432/freed?schema=public"
PORT=4000

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Marketplace economics (basis points; 1500 = 15%)
PLATFORM_FEE_BPS=1500
GST_BPS=1800

# Integrations (added after commercial/legal review — never hardcode secrets)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
S3_BUCKET=""
S3_REGION=""
AGORA_APP_ID=""
